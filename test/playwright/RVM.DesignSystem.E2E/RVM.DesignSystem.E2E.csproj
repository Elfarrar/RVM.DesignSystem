<Project Sdk="Microsoft.NET.Sdk">

  <!--
    E2E vive sob test/playwright/ de proposito: o ci.yml@v1 do RVM.Actions roda
    todo test/**/*.csproj e pula so os caminhos que contem 'playwright'. Aqui o E2E
    exige o site publicado no ar, entao nao pode rodar no CI de build. Nao mover.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
