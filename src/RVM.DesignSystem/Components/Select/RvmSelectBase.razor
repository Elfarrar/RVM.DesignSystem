@namespace RVM.DesignSystem.Components.Select
@typeparam TValue
@using RVM.DesignSystem.Components.Icon
@using RVM.DesignSystem.Icons

@* O padrao "Select-Only Combobox" do APG: o foco fica no gatilho (role=combobox) e a opcao ativa e
   apontada por aria-activedescendant — as opcoes nunca recebem foco. Com busca, o foco vai para o
   campo de busca, que aponta a opcao ativa do mesmo jeito.
   O visual e o do RvmTextField (mesmas medidas do kit: 56 e 40 px). Fechado, a lista nao existe no
   DOM: o estado inicial sai pronto sem JS. *@
<div class="@ClassesDaRaiz" style="@EstiloDoConsumidor">
    <div class="caixa">
        <div @ref="_gatilho"
             @attributes="AtributosDoGatilho"
             id="@IdGatilho"
             role="combobox"
             class="entrada"
             tabindex="@(Disabled ? "-1" : "0")"
             aria-haspopup="listbox"
             aria-expanded="@(_aberto ? "true" : "false")"
             aria-controls="@(_aberto ? IdLista : null)"
             aria-labelledby="@(string.IsNullOrWhiteSpace(Label) ? null : IdRotulo)"
             aria-activedescendant="@(_aberto && !Searchable ? IdDaOpcaoAtiva : null)"
             aria-required="@(Required ? "true" : null)"
             aria-invalid="@(TemErro ? "true" : null)"
             aria-disabled="@(Disabled ? "true" : null)"
             aria-describedby="@(MensagemDeApoio is null ? null : IdApoio)"
             @onclick="AoClicarNoGatilhoAsync"
             @onkeydown="AoTeclarNoGatilhoAsync">
            <span class="valor">@(TemValor ? TextoExibido : Placeholder)</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <span id="@IdRotulo" class="rotulo" @onclick="FocarGatilhoAsync">
                @Label
                @if (Required)
                {
                    <span class="obrigatorio" aria-hidden="true">*</span>
                }
            </span>
        }

        <span class="seta" aria-hidden="true">
            <RvmIcon Name="RvmIconName.ChevronDown" Size="RvmSize.Small" />
        </span>
    </div>

    @if (MensagemDeApoio is not null)
    {
        <div id="@IdApoio" class="apoio rvm-text-helper">@MensagemDeApoio</div>
    }

    @if (!string.IsNullOrWhiteSpace(Name))
    {
        @foreach (var valor in ValoresParaEnvio)
        {
            <input type="hidden" name="@Name" value="@valor" />
        }
    }

    @if (_aberto)
    {
        <div class="fundo" @onclick="() => FecharAsync(devolverFoco: false)"></div>

        <div class="popup">
            @if (Searchable)
            {
                <input @ref="_busca"
                       type="text"
                       class="busca"
                       autocomplete="off"
                       placeholder="@SearchPlaceholder"
                       aria-label="@SearchPlaceholder"
                       aria-controls="@IdLista"
                       aria-activedescendant="@IdDaOpcaoAtiva"
                       value="@_termo"
                       @oninput="AoBuscarAsync"
                       @onkeydown="AoTeclarNaBuscaAsync" />
            }

            @if (Filtradas.Count == 0)
            {
                <div class="vazio rvm-text-body2" role="status">@NoResultsText</div>
            }

            <ul id="@IdLista"
                role="listbox"
                class="opcoes"
                aria-labelledby="@(string.IsNullOrWhiteSpace(Label) ? null : IdRotulo)"
                aria-multiselectable="@(Multiplo ? "true" : null)">
                @for (var i = 0; i < Filtradas.Count; i++)
                {
                    var item = Filtradas[i];
                    var indice = i;
                    var selecionada = EstaSelecionado(item);
                    var desabilitada = OpcaoDesabilitada(item);
                    <li id="@IdDaOpcao(indice)"
                        role="option"
                        class="@ClassesDaOpcao(indice, selecionada, desabilitada)"
                        aria-selected="@(selecionada ? "true" : "false")"
                        aria-disabled="@(desabilitada ? "true" : null)"
                        @onmousedown:preventDefault="true"
                        @onclick="() => EscolherAsync(indice)">
                        @if (Multiplo)
                        {
                            <span class="marca" aria-hidden="true">
                                @if (selecionada)
                                {
                                    <RvmIcon Name="RvmIconName.Check" Size="RvmSize.Small" />
                                }
                            </span>
                        }
                        <span class="texto-opcao">@TextoDe(item)</span>
                    </li>
                }
            </ul>
        </div>
    }
</div>
