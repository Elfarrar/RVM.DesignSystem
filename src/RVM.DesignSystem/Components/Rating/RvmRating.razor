@namespace RVM.DesignSystem.Components.Rating

@* Editavel: um grupo de radios NATIVOS (fieldset + legend) — setas mudam a nota, Tab entra e sai do
   grupo, funciona em formulario sem JS. Os radios ficam invisiveis por cima das estrelas; cada um cobre
   o trecho da nota que representa (meia estrela com AllowHalf).
   Somente leitura: uma imagem com a nota por extenso ("Nota 3,5 de 5"). *@
@if (ReadOnly)
{
    <span @attributes="AdditionalAttributes" class="@ClassesDaRaiz" role="img" aria-label="@RotuloDeLeitura">
        @Estrelas(Value)
    </span>
}
else
{
    <fieldset @attributes="AdditionalAttributes" class="@ClassesDaRaiz" disabled="@Disabled" @onmouseleave="() => _sobre = null">
        <legend class="rvm-so-leitor">@Label</legend>
        @Estrelas(_sobre ?? Value)
        <span class="rvm-alvos">
            @foreach (var nota in Notas)
            {
                var valor = nota;
                <label class="rvm-alvo" style="@EstiloDoAlvo(valor)" @onmouseenter="() => _sobre = Disabled ? null : valor">
                    <input type="radio"
                           class="rvm-so-leitor"
                           name="@NomeDoGrupo"
                           value="@ValorInvariante(valor)"
                           checked="@(Value == valor)"
                           @onchange="() => EscolherAsync(valor)" />
                    <span class="rvm-so-leitor">@TextoDaNota(valor)</span>
                </label>
            }
        </span>
    </fieldset>
}

@code {
    private RenderFragment Estrelas(double nota) => @<span class="rvm-estrelas" aria-hidden="true">
        @for (var i = 1; i <= Max; i++)
        {
            var preenchido = Math.Clamp(nota - (i - 1), 0, 1);
            <span class="rvm-estrela">
                <svg class="rvm-vazia" viewBox="0 0 24 24" focusable="false"><path d="@CaminhoDaEstrela" /></svg>
                <span class="rvm-cheia" style="@LarguraDoPreenchimento(preenchido)">
                    <svg viewBox="0 0 24 24" focusable="false"><path d="@CaminhoDaEstrela" /></svg>
                </span>
            </span>
        }
    </span>;
}
