@namespace RVM.DesignSystem.Components.Lists
@using RVM.DesignSystem.Components.Icon
@using RVM.DesignSystem.Icons

@* O item e um <li> com duas areas lado a lado: a principal (link, botao ou texto parado) e a acao
   da direita. A acao fica FORA da principal de proposito — botao dentro de botao e HTML invalido e o
   leitor de tela so enxerga um dos dois. *@
<li @attributes="AdditionalAttributes" class="@ClassesDoItem">
    <div class="rvm-linha">
        @if (!string.IsNullOrWhiteSpace(Href))
        {
            <a class="rvm-principal rvm-interativo" href="@(Disabled ? null : Href)"
               aria-current="@(Selected ? "page" : null)"
               aria-disabled="@(Disabled ? "true" : null)">
                @Conteudo
            </a>
        }
        else if (Aninhado)
        {
            <button type="button" class="rvm-principal rvm-interativo"
                    aria-expanded="@(_aberto ? "true" : "false")"
                    aria-controls="@(_aberto ? IdAninhada : null)"
                    disabled="@Disabled"
                    @onclick="AlternarAsync">
                @Conteudo
                <span class="rvm-seta" aria-hidden="true">
                    <RvmIcon Name="@(_aberto ? RvmIconName.ChevronUp : RvmIconName.ChevronDown)" Size="RvmSize.Small" />
                </span>
            </button>
        }
        else if (OnClick.HasDelegate)
        {
            <button type="button" class="rvm-principal rvm-interativo"
                    aria-pressed="@(Selected ? "true" : "false")"
                    disabled="@Disabled"
                    @onclick="AoClicarAsync">
                @Conteudo
            </button>
        }
        else
        {
            <div class="rvm-principal">@Conteudo</div>
        }

        @if (TemValor)
        {
            @* Valor e variacao a direita (contrato com o RVM.UI, DSGN-017). A seta e desenho: o texto da
               variacao diz se subiu ou caiu para quem nao ve a cor. *@
            <div class="rvm-valor-do-item">
                <span class="rvm-valor-linha">
                    @if (!string.IsNullOrWhiteSpace(Value))
                    {
                        <span class="rvm-valor">@Value</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(TrendLabel))
                    {
                        <span class="@(Trend switch { RvmTrend.Up => "rvm-variacao rvm-subiu", RvmTrend.Down => "rvm-variacao rvm-caiu", _ => "rvm-variacao" })">
                            @if (Trend != RvmTrend.None)
                            {
                                <RvmIcon Name="@(Trend == RvmTrend.Up ? RvmIconName.ArrowUp : RvmIconName.ArrowDown)" Size="RvmSize.Small" />
                                <span class="rvm-so-leitor">@(Trend == RvmTrend.Up ? "subiu" : "caiu")</span>
                            }
                            @TrendLabel
                        </span>
                    }
                </span>
                @if (!string.IsNullOrWhiteSpace(ValueSubtitle))
                {
                    <span class="rvm-secundario">@ValueSubtitle</span>
                }
            </div>
        }

        @if (EndContent is not null)
        {
            <div class="rvm-fim">@EndContent</div>
        }
    </div>

    @if (Aninhado && _aberto)
    {
        <div id="@IdAninhada" class="rvm-aninhada">@NestedContent</div>
    }
</li>

@code {
    private RenderFragment Conteudo => @<text>
        @if (StartContent is not null)
        {
            <span class="rvm-inicio">@StartContent</span>
        }
        else if (Icon is { } icone)
        {
            <span class="rvm-inicio rvm-icone" aria-hidden="true"><RvmIcon Name="icone" /></span>
        }
        <span class="rvm-textos">
            <span class="rvm-primario">@(ChildContent ?? (b => b.AddContent(0, Title)))</span>
            @if (SubtitleContent is not null)
            {
                <span class="rvm-secundario">@SubtitleContent</span>
            }
            else if (!string.IsNullOrWhiteSpace(SecondaryText))
            {
                <span class="rvm-secundario">@SecondaryText</span>
            }
        </span>
    </text>;
}
