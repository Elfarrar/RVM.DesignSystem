@namespace RVM.DesignSystem.Components.Page

@* A faixa abaixo do cabecalho da pagina, com o que a pagina oferece (busca, abas, filtros) de um lado e do outro. *@
<div @attributes="AdditionalAttributes" class="@ClassesCss.Juntar("rvm-barra-pagina", Class, AdditionalAttributes)">
    <div class="rvm-inicio">@Start</div>
    <div class="rvm-fim">@End</div>
</div>

@code {
    /// <summary>Lado esquerdo (busca, abas).</summary>
    [Parameter] public RenderFragment? Start { get; set; }

    /// <summary>Lado direito (filtros, botoes).</summary>
    [Parameter] public RenderFragment? End { get; set; }

    /// <summary>Classe CSS extra no elemento raiz.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Atributos repassados ao elemento raiz.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
