@namespace RVM.DesignSystem.Components.Dialog
@using RVM.DesignSystem.Components.Icon
@using RVM.DesignSystem.Icons

@* role="dialog" (ou "alertdialog", para confirmacao) com aria-modal e nome pelo titulo. Aberto no
   primeiro render, aparece aberto sem JS; o JS so prende o foco e devolve ao fechar.
   Esc fecha pelo evento do Blazor, que NAO sobe para o dialogo de fora: com um dialogo aberto sobre
   outro, o Esc fechava os dois (review da onda 3). Clicar no fundo fecha se CloseOnBackdropClick.
   ⚠️ Sem portal: o dialogo fica onde foi declarado, e position: fixed passa a valer em relacao a um
   ancestral com transform, filter, perspective ou contain. Declare-o fora desses containers. *@
@if (Open)
{
    <div class="@ClassesDaRaiz">
        <div class="rvm-fundo" aria-hidden="true" @onclick="AoClicarNoFundoAsync"></div>

        <div @ref="_caixa"
             @attributes="AdditionalAttributes"
             class="rvm-caixa"
             role="@(Alert ? "alertdialog" : "dialog")"
             aria-modal="true"
             aria-labelledby="@(string.IsNullOrWhiteSpace(Title) ? null : IdTitulo)"
             aria-describedby="@(Alert ? IdConteudo : null)"
             tabindex="-1"
             @onkeydown="AoTeclarAsync"
             @onkeydown:stopPropagation="true">
            @if (!string.IsNullOrWhiteSpace(Title) || ShowCloseButton)
            {
                <div class="rvm-topo">
                    @if (!string.IsNullOrWhiteSpace(Title))
                    {
                        <h2 id="@IdTitulo" class="rvm-titulo">@Title</h2>
                    }
                    @if (ShowCloseButton)
                    {
                        <button type="button" class="rvm-fechar" aria-label="@CloseLabel" @onclick="FecharAsync">
                            <RvmIcon Name="RvmIconName.Close" />
                        </button>
                    }
                </div>
            }

            <div id="@IdConteudo" class="rvm-conteudo">@ChildContent</div>

            @if (Actions is not null)
            {
                <div class="rvm-acoes">@Actions</div>
            }
        </div>
    </div>
}
