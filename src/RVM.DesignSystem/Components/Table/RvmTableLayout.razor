@namespace RVM.DesignSystem.Components.Table

@* A CASCA da tabela de dados (contrato com o RVM.UI, DSGN-017): cartao, cabecalho com acoes, a <table> e o
   rodape. Quem monta as linhas e o app (RvmRow + RvmHeaderCell); para ligar direto a uma lista tipada, o
   RvmDataTable, que desenha esta mesma casca. Carregando, erro e vazio moram AQUI, pelo EstadosDosDados, para
   nenhum app esquecer de tratar os tres. Visual da RvmTable, medido no referencia-neatlab/Table.png. *@
<div @attributes="AdditionalAttributes" class="@ClassesDaRaiz">
    @if (Header is not null || Toolbar is not null)
    {
        <div class="rvm-cabecalho-tabela">
            <div class="rvm-titulo-tabela">@Header</div>
            @if (Toolbar is { } acoes)
            {
                <div class="rvm-acoes-tabela">@acoes</div>
            }
        </div>
    }

    @* Area que rola na horizontal: focavel e com nome, senao quem usa teclado nao rola (scrollable-region-focusable do axe). *@
    <div class="rvm-rolagem" role="region" aria-label="@Caption" tabindex="0">
        <table class="rvm-tabela-nativa">
            <caption class="rvm-so-leitor">@Caption</caption>
            @if (Head is { } cabecalho)
            {
                <thead>
                    <tr class="rvm-linha-cabecalho">@cabecalho</tr>
                </thead>
            }
            <tbody>
                @if (Estado is EstadoDosDados.Conteudo)
                {
                    @Body
                }
                else
                {
                    @* Uma celula que atravessa a tabela toda. O colspan alto e inofensivo (o navegador limita ao numero
                       real de colunas) e poupa o app de contar colunas — a casca nao sabe quantas sao. *@
                    <tr class="rvm-linha-estado">
                        <td colspan="99">
                            @(Estado switch
                            {
                                EstadoDosDados.Erro => EstadosDosDados.Erro(ErrorContent, ErrorTitle, ErrorText, ErrorMascot),
                                EstadoDosDados.Carregando => EstadosDosDados.Carregando(LoadingText, LoadingMascot),
                                _ => EstadosDosDados.Vazio(Empty, EmptyText)
                            })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Footer is { } rodape)
    {
        <div class="rvm-rodape-tabela">@rodape</div>
    }
</div>

@code {
    /// <summary>
    /// O que a tabela mostra, para quem usa leitor de tela ("Talhoes da safra"). Vai num <c>caption</c> escondido e
    /// tambem nomeia a area de rolagem.
    /// </summary>
    [Parameter, EditorRequired] public string Caption { get; set; } = string.Empty;

    /// <summary>A linha de cabecalho: os <see cref="RvmHeaderCell"/>. A casca poe o <c>thead</c> e o <c>tr</c>.</summary>
    [Parameter] public RenderFragment? Head { get; set; }

    /// <summary>As linhas: <see cref="RvmRow"/>.</summary>
    [Parameter] public RenderFragment? Body { get; set; }

    /// <summary>Titulo e descricao acima da tabela.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Acoes no alto, a direita do <see cref="Header"/> (busca, filtro, botao).</summary>
    [Parameter] public RenderFragment? Toolbar { get; set; }

    /// <summary>Rodape abaixo da tabela: contagem e paginacao.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Os dados estao chegando: o corpo da lugar ao aviso de carregamento.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>Nao ha linhas. O corpo da lugar ao <see cref="Empty"/> (ou ao <see cref="EmptyText"/>).</summary>
    [Parameter] public bool IsEmpty { get; set; }

    /// <summary>A carga falhou. Vence <see cref="Loading"/>, que vence <see cref="IsEmpty"/>.</summary>
    [Parameter] public bool Error { get; set; }

    /// <summary>
    /// O vazio, ensinando o proximo passo. Sem ele, sai um <c>RvmEmptyState</c> com <see cref="EmptyText"/>. Ligue
    /// <c>Status</c> no seu <c>RvmEmptyState</c>: o vazio aparece depois de um carregamento ou filtro.
    /// </summary>
    [Parameter] public RenderFragment? Empty { get; set; }

    /// <summary>O erro. Sem ele, sai o <c>RvmEmptyState</c> de erro com <see cref="ErrorTitle"/> e <see cref="ErrorText"/>.</summary>
    [Parameter] public RenderFragment? ErrorContent { get; set; }

    /// <summary>Mascote do erro padrao, no lugar do icone. Sem efeito com <see cref="ErrorContent"/>.</summary>
    [Parameter] public RvmMascotName? ErrorMascot { get; set; }

    /// <summary>Mascote do carregamento, no lugar do indicador circular.</summary>
    [Parameter] public RvmMascotName? LoadingMascot { get; set; }

    /// <summary>Texto do carregamento.</summary>
    [Parameter] public string LoadingText { get; set; } = "Carregando...";

    /// <summary>Texto do vazio padrao. Prefira <see cref="Empty"/>, que ensina o proximo passo.</summary>
    [Parameter] public string EmptyText { get; set; } = "Nada para mostrar aqui ainda.";

    /// <summary>Titulo do erro padrao.</summary>
    [Parameter] public string ErrorTitle { get; set; } = "Nao deu para carregar";

    /// <summary>Texto do erro padrao.</summary>
    [Parameter] public string ErrorText { get; set; } = EstadosDosDados.TextoDeErro;

    /// <summary>Classe CSS extra no elemento raiz.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Atributos extras, repassados ao elemento raiz.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private EstadoDosDados Estado => EstadosDosDados.Qual(Error, Loading, IsEmpty);

    private string ClassesDaRaiz => ClassesCss.Juntar("rvm-tabela-montada", Class, AdditionalAttributes);
}
