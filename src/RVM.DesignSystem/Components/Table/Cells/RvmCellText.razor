@namespace RVM.DesignSystem.Components.Table

@* Celula de texto (contrato com o RVM.UI, DSGN-017): o texto e, embaixo, a segunda linha opcional. *@
<RvmCellFrame Align="Align" Class="@Class" AdditionalAttributes="AdditionalAttributes">
    <RvmCellLines Text="@Text" Supporting="@Supporting" Highlight="Highlight" ChildContent="ChildContent" />
</RvmCellFrame>

@code {
    /// <summary>O texto da celula.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Conteudo livre, no lugar do texto.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Segunda linha, menor e mais clara.</summary>
    [Parameter] public string? Supporting { get; set; }

    /// <summary>Destaque: a coluna que identifica a linha, com o texto mais pesado.</summary>
    [Parameter] public bool Highlight { get; set; }

    /// <summary>Alinhamento do conteudo. Padrao: <see cref="RvmAlign.Start"/>.</summary>
    [Parameter] public RvmAlign Align { get; set; } = RvmAlign.Start;

    /// <summary>Classe CSS extra no <c>&lt;td&gt;</c>.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Atributos extras no <c>&lt;td&gt;</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
