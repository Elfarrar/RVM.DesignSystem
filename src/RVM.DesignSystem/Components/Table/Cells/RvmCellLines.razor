@namespace RVM.DesignSystem.Components.Table

@* O texto das celulas: o titulo e, embaixo, a segunda linha menor e mais clara (Supporting Text do kit). E o mesmo
   bloco na celula de texto, de usuario, de imagem, de arquivo e de selo. Publico so porque componente Razor nao pode
   ser internal. *@
<span class="@(Highlight ? "rvm-celula-texto rvm-destaque" : "rvm-celula-texto")">
    <span class="rvm-titulo">@(ChildContent is null ? Text : null)@ChildContent</span>
    @if (!string.IsNullOrWhiteSpace(Supporting))
    {
        <span class="rvm-apoio">@Supporting</span>
    }
</span>
