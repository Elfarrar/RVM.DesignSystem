@namespace RVM.DesignSystem.Components.Table

@* Celula de codigo (contrato com o RVM.UI, DSGN-017): o identificador da linha (nota, pedido, lote). No kit e o "#4910"
   da lista de faturas, na cor primaria e sempre no peso de destaque — por isso nao ha Highlight aqui. *@
<RvmCellFrame Align="Align" FrameClass="rvm-celula-numero" Class="@Class" AdditionalAttributes="AdditionalAttributes">
    <span class="rvm-codigo">@(ChildContent is null ? Text : null)@ChildContent</span>
</RvmCellFrame>

@code {
    /// <summary>O codigo.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Conteudo livre no lugar do texto (um link para o documento, por exemplo).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Alinhamento do conteudo. Padrao: <see cref="RvmAlign.Start"/>.</summary>
    [Parameter] public RvmAlign Align { get; set; } = RvmAlign.Start;

    /// <summary>Classe CSS extra no <c>&lt;td&gt;</c>.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Atributos extras no <c>&lt;td&gt;</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
