@namespace RVM.DesignSystem.Components.Table

@* Celula de progresso (contrato com o RVM.UI, DSGN-017): o RvmProgressBar com o rotulo de valor e a porcentagem.
   Nada redesenhado — so a largura minima, que numa fileira flex a barra encolheria ate sumir. *@
<RvmCellFrame Align="Align" Class="@Class" AdditionalAttributes="AdditionalAttributes">
    <div class="rvm-barra-da-celula">
        <RvmProgressBar Value="Value" Label="@Label" LabelVariant="RvmProgressLabelVariant.Amount" ShowValue="true" Color="Color" />
    </div>
</RvmCellFrame>

@code {
    /// <summary>Progresso de 0 a 100.</summary>
    [Parameter, EditorRequired] public double Value { get; set; }

    /// <summary>O rotulo da barra ("R$ 12.400").</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>Papel de cor da barra. Padrao: <see cref="RvmColor.Accent"/>.</summary>
    [Parameter] public RvmColor Color { get; set; } = RvmColor.Accent;

    /// <summary>Alinhamento do conteudo. Padrao: <see cref="RvmAlign.Start"/>.</summary>
    [Parameter] public RvmAlign Align { get; set; } = RvmAlign.Start;

    /// <summary>Classe CSS extra no <c>&lt;td&gt;</c>.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Atributos extras no <c>&lt;td&gt;</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
