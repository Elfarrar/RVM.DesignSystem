@namespace RVM.DesignSystem.Components.Table

@* Celula de usuario (contrato com o RVM.UI, DSGN-017): avatar e nome, com o e-mail embaixo — a coluna "User" da lista
   de usuarios do kit. O avatar e DECORATIVO (alt vazio): o nome esta escrito logo ao lado, e anunciar "Ana Ribeiro,
   imagem, Ana Ribeiro" a cada linha so atrasa quem ouve a tabela. Sem foto, o icone de pessoa no fundo suave. *@
<RvmCellFrame Align="Align" Class="@Class" AdditionalAttributes="AdditionalAttributes">
    <RvmAvatar Src="@Src" Alt="" Icon="RvmIconName.User" Variant="RvmAvatarVariant.Soft" />
    <RvmCellLines Text="@Name" Supporting="@Supporting" Highlight="Highlight" />
</RvmCellFrame>

@code {
    /// <summary>Nome da pessoa: o titulo da celula.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>Foto. Sem ela, o icone de pessoa.</summary>
    [Parameter] public string? Src { get; set; }

    /// <summary>Segunda linha, geralmente o e-mail.</summary>
    [Parameter] public string? Supporting { get; set; }

    /// <summary>Destaque: o nome mais pesado.</summary>
    [Parameter] public bool Highlight { get; set; }

    /// <summary>Alinhamento do conteudo. Padrao: <see cref="RvmAlign.Start"/>.</summary>
    [Parameter] public RvmAlign Align { get; set; } = RvmAlign.Start;

    /// <summary>Classe CSS extra no <c>&lt;td&gt;</c>.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Atributos extras no <c>&lt;td&gt;</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
