@namespace RVM.DesignSystem.Components.AppShell
@using RVM.DesignSystem.Components.Sidebar
@using RVM.DesignSystem.Components.Icon
@using RVM.DesignSystem.Icons

@* Item que abre subitens (o "Dashboards" do kit). E um botao com aria-expanded; os subitens so existem
   no DOM quando aberto. Recolhido, clicar expande o menu e abre o grupo — com o menu nos icones nao ha
   onde mostrar os subitens. aria-controls so sai com a lista no DOM: apontar para id inexistente e ARIA
   invalido (achado do review da onda 4). *@
<li @attributes="AdditionalAttributes" class="@ClassesCss.Juntar("rvm-nav-item", Class, AdditionalAttributes)">
    <button type="button"
            class="@ClassesDoBotao"
            aria-expanded="@(Expanded && !Recolhido ? "true" : "false")"
            aria-current="@(Atual ? "true" : null)"
            aria-controls="@(Expanded && !Recolhido ? _id : null)"
            title="@(Recolhido ? Text : null)"
            @onclick="AlternarAsync">
        @if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            <img class="rvm-nav-imagem" src="@ImageUrl" alt="" />
        }
        else
        {
            <RvmIcon Name="Icon" Size="RvmSize.Large" class="rvm-nav-icone" />
        }
        <span class="rvm-nav-texto">@Text</span>
        @if (!string.IsNullOrWhiteSpace(Badge))
        {
            <span class="rvm-nav-selo">@Badge</span>
        }
        <RvmIcon Name="RvmIconName.ChevronDown" Size="RvmSize.Small" class="rvm-nav-seta" />
    </button>
    @if (Expanded && !Recolhido)
    {
        <CascadingValue Name="@NomeDaCascata" Value="this" IsFixed="true">
            <ul id="@_id" class="rvm-nav-lista rvm-nav-subitens">
                @ChildContent
            </ul>
        </CascadingValue>
    }
</li>

@code {
    internal const string NomeDaCascata = "RvmNavGroup";

    private static int _proximoId;
    private readonly string _id = $"rvm-nav-grupo-{Interlocked.Increment(ref _proximoId)}";

    [CascadingParameter] private RvmSidebar? Casca { get; set; }

    /// <summary>Texto do grupo.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>Icone do grupo.</summary>
    [Parameter, EditorRequired] public RvmIconName Icon { get; set; }

    /// <summary>Selo ao lado do texto ("Novo").</summary>
    [Parameter] public string? Badge { get; set; }

    /// <summary>Subitens a mostra. Aceita <c>@bind-Expanded</c>.</summary>
    [Parameter] public bool Expanded { get; set; }

    /// <summary>Disparado quando o grupo abre ou fecha.</summary>
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }

    /// <summary>Os subitens: <see cref="RvmNavItem"/> sem icone.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Imagem redonda no lugar do icone (decorativa).</summary>
    [Parameter] public string? ImageUrl { get; set; }

    /// <summary>
    /// Caminho relativo do grupo (<c>"financeiro"</c>): a rota igual a ele ou abaixo dele marca o grupo como atual e o
    /// abre na primeira vez.
    /// </summary>
    [Parameter] public string? ActivePrefix { get; set; }

    [Inject] private NavigationManager Navegacao { get; set; } = default!;

    private bool _rotaConferida;

    private bool Atual
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ActivePrefix)) return false;
            var relativo = "/" + Navegacao.ToBaseRelativePath(Navegacao.Uri).Split('?', '#')[0].Trim('/');
            var prefixo = "/" + ActivePrefix.Trim('/');
            return relativo.Equals(prefixo, StringComparison.OrdinalIgnoreCase)
                   || relativo.StartsWith(prefixo + "/", StringComparison.OrdinalIgnoreCase);
        }
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        // So na primeira vez: depois, quem fecha o grupo e a pessoa, e a rota nao reabre.
        if (_rotaConferida)
        {
            return;
        }

        _rotaConferida = true;
        if (Atual && !Expanded)
        {
            Expanded = true;
            await ExpandedChanged.InvokeAsync(true);
        }
    }

    /// <summary>Classe CSS extra no elemento raiz.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Atributos repassados ao elemento raiz.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool Recolhido => Casca?.Recolhido == true;

    private string ClassesDoBotao
        => "rvm-nav-link rvm-nav-grupo"
           + (Expanded && !Recolhido ? " rvm-aberto" : "")
           + (Recolhido ? " rvm-recolhido" : "")
           + (Atual ? " rvm-ativo" : "");

    private async Task AlternarAsync()
    {
        if (Recolhido)
        {
            await Casca!.DefinirRecolhidoAsync(false);
            if (Expanded)
            {
                return;
            }
        }

        Expanded = !Expanded;
        await ExpandedChanged.InvokeAsync(Expanded);
    }
}
