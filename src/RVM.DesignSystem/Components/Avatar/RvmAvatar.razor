@namespace RVM.DesignSystem.Components.Avatar
@using RVM.DesignSystem.Components.Icon

@* Com imagem, o nome acessivel e o `alt` da propria <img>. Sem imagem, o avatar vira `role="img"`
   com `aria-label`: iniciais soltas ("RV") nao dizem nada a quem ouve a pagina. *@
@if (TemImagem && !_imagemFalhou)
{
    <span @attributes="AdditionalAttributes" class="@CssClass">
        <img src="@Src" alt="@Alt" class="foto" @onerror="AoFalharImagem" />
    </span>
}
else
{
    @* Sem nome nenhum (so icone, sem Alt nem Initials), o avatar e decorativo: `role="img"` sem nome
       faria o leitor de tela anunciar so "imagem". Entao sai escondido, e nao mudo. *@
    <span @attributes="AdditionalAttributes" class="@CssClass"
          role="@(NomeAcessivel is null ? null : "img")"
          aria-label="@NomeAcessivel"
          aria-hidden="@(NomeAcessivel is null ? "true" : null)">
        @if (Icon is not null)
        {
            <RvmIcon Name="Icon.Value" Size="@TamanhoDoIcone" />
        }
        else if (!string.IsNullOrWhiteSpace(Initials))
        {
            <span class="iniciais" aria-hidden="true">@IniciaisExibidas</span>
        }
        else
        {
            @ChildContent
        }
    </span>
}
