@namespace RVM.DesignSystem.Components.Accordion
@using RVM.DesignSystem.Components.Icon
@using RVM.DesignSystem.Icons

@* Painel expansivel sozinho (o padrao "Accordion" do APG para um painel): o botao fica dentro de um titulo e
   aponta a regiao. Diferente do RvmAccordionPanel, o corpo continua MONTADO quando fecha (hidden) — o que foi
   digitado nao se perde —, e o cabecalho aceita conteudo composto. O visual e o do painel do acordeao. *@
<div @attributes="AdditionalAttributes" class="@ClassesDaRaiz">
    @switch (Math.Clamp(HeadingLevel, 2, 6))
    {
        case 2: <h2 class="rvm-cabecalho">@Botao</h2> break;
        case 4: <h4 class="rvm-cabecalho">@Botao</h4> break;
        case 5: <h5 class="rvm-cabecalho">@Botao</h5> break;
        case 6: <h6 class="rvm-cabecalho">@Botao</h6> break;
        default: <h3 class="rvm-cabecalho">@Botao</h3> break;
    }
    <div id="@_idRegiao" role="region" aria-labelledby="@_idBotao" class="rvm-conteudo" hidden="@(!Expanded)">
        @ChildContent
    </div>
</div>

@code {
    private readonly string _idBotao = GeradorDeIds.Novo("rvm-expansivel-botao");
    private readonly string _idRegiao = GeradorDeIds.Novo("rvm-expansivel-regiao");

    private RenderFragment Botao => @<button type="button" id="@_idBotao" class="rvm-gatilho" aria-expanded="@(Expanded ? "true" : "false")"
                                              aria-controls="@_idRegiao" disabled="@Disabled" @onclick="AlternarAsync">
        @if (Icon is { } icone)
        {
            <span class="rvm-icone" aria-hidden="true"><RvmIcon Name="icone" Size="RvmSize.Small" /></span>
        }
        <span class="rvm-titulo">@(TitleContent ?? (b => b.AddContent(0, Title)))</span>
        <span class="rvm-marca" aria-hidden="true"><RvmIcon Name="@(Expanded ? RvmIconName.ChevronUp : RvmIconName.ChevronDown)" Size="RvmSize.Small" /></span>
    </button>;

    /// <summary>Texto do cabecalho.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Cabecalho composto (icone, numero, selo). Vence <see cref="Title"/>. So conteudo de frase: fica dentro de um botao.</summary>
    [Parameter] public RenderFragment? TitleContent { get; set; }

    /// <summary>Icone antes do titulo.</summary>
    [Parameter] public RvmIconName? Icon { get; set; }

    /// <summary>Aberto. Aceita <c>@bind-Expanded</c>.</summary>
    [Parameter] public bool Expanded { get; set; }

    /// <summary>Avisa quando abre ou fecha.</summary>
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }

    /// <summary>Nao abre nem fecha.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Nivel do titulo (2 a 6). Padrao: 3.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 3;

    /// <summary>O conteudo do painel.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Classe CSS extra no elemento raiz.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Atributos repassados ao elemento raiz.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassesDaRaiz => ClassesCss.Juntar(Disabled ? "rvm-painel rvm-desabilitado" : "rvm-painel", Class, AdditionalAttributes);

    private async Task AlternarAsync()
    {
        Expanded = !Expanded;
        await ExpandedChanged.InvokeAsync(Expanded);
    }
}
