@namespace RVM.DesignSystem.Components.IconButton
@using Microsoft.AspNetCore.Components.Web
@using RVM.DesignSystem.Components.Button
@using RVM.DesignSystem.Components.Icon
@using RVM.DesignSystem.Icons

@* Botao so de icone. O Label e o unico nome acessivel (sem texto visivel), e vai tambem no title para quem usa
   mouse descobrir o que o botao faz. *@
<button @attributes="AdditionalAttributes"
        type="@TipoHtml"
        class="@ClassesDaRaiz"
        aria-label="@Label"
        title="@Label"
        disabled="@Disabled"
        @onclick="OnClick">
    <RvmIcon Name="Icon" Size="@(Size == RvmSize.Small ? RvmSize.Small : RvmSize.Medium)" />
</button>

@code {
    /// <summary>O icone.</summary>
    [Parameter, EditorRequired] public RvmIconName Icon { get; set; }

    /// <summary>O que o botao faz ("Excluir"). Obrigatorio: e o nome acessivel e a dica.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Peso visual. Padrao: so o icone (<see cref="RvmButtonVariant.Text"/>).</summary>
    [Parameter] public RvmButtonVariant Variant { get; set; } = RvmButtonVariant.Text;

    /// <summary>Papel de cor. Padrao: secundario, o cinza dos icones do kit.</summary>
    [Parameter] public RvmColor Color { get; set; } = RvmColor.Secondary;

    /// <summary>Lado do botao: 30, 38 (padrao) ou 42 px, as alturas do <c>RvmButton</c>.</summary>
    [Parameter] public RvmSize Size { get; set; } = RvmSize.Medium;

    /// <summary>O <c>type</c> do botao. Padrao: <c>button</c>, que nao envia formulario.</summary>
    [Parameter] public RvmButtonType Type { get; set; } = RvmButtonType.Button;

    /// <summary>Indisponivel.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Clique.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Classe CSS extra no elemento raiz.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Atributos repassados ao elemento raiz.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string TipoHtml => Type switch { RvmButtonType.Submit => "submit", RvmButtonType.Reset => "reset", _ => "button" };

    private string ClassesDaRaiz
    {
        get
        {
            var variante = Variant switch
            {
                RvmButtonVariant.Contained => "rvm-preenchido",
                RvmButtonVariant.Outlined => "rvm-contorno",
                RvmButtonVariant.Soft => "rvm-suave",
                _ => "rvm-texto"
            };
            var tamanho = Size switch { RvmSize.Small => "rvm-pequeno", RvmSize.Large => "rvm-grande", _ => "rvm-medio" };
            return ClassesCss.Juntar($"rvm-botao-icone {variante} {tamanho} {PapelCss.Classe(Color)}", Class, AdditionalAttributes);
        }
    }
}
