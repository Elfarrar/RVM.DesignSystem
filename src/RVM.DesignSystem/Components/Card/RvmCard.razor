@namespace RVM.DesignSystem.Components.Card
@using RVM.DesignSystem.Components.Typography

<div @attributes="AdditionalAttributes" class="@CssClass">
    @if (!string.IsNullOrWhiteSpace(MediaSrc))
    {
        @* A altura vem por atributo e nao por style, para nao disputar o `style` do consumidor. *@
        <img class="rvm-midia" src="@MediaSrc" alt="@(MediaAlt ?? string.Empty)" height="@MediaHeight" />
    }

    @if (TemCabecalho)
    {
        <div class="rvm-cabecalho">
            <div class="rvm-textos">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <RvmTypography Variant="RvmTypographyVariant.H6" As="@TitleElement" class="rvm-titulo">@Title</RvmTypography>
                }
                @if (!string.IsNullOrWhiteSpace(Subheader))
                {
                    <RvmTypography Variant="RvmTypographyVariant.Body2" Color="RvmTextColor.Secondary">@Subheader</RvmTypography>
                }
            </div>
            @HeaderAction
        </div>
    }

    @if (ChildContent is not null)
    {
        <div class="rvm-conteudo rvm-text-body2">@ChildContent</div>
    }

    @if (Actions is not null)
    {
        <div class="rvm-acoes">@Actions</div>
    }
</div>
