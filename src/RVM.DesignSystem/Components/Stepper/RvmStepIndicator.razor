@namespace RVM.DesignSystem.Components.Stepper

@* O numero do passo num circulo, dentro de um formulario longo. Nao e botao: o numero nao leva a lugar
   nenhum. O passo atual sai cheio na cor primaria e com aria-current="step". *@
<span @attributes="AdditionalAttributes" class="@ClassesDaRaiz" aria-current="@(Active ? "step" : null)">@(Text ?? Number.ToString(System.Globalization.CultureInfo.CurrentCulture))</span>

@code {
    /// <summary>Numero do passo.</summary>
    [Parameter] public int Number { get; set; }

    /// <summary>Texto no lugar do numero ("...").</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Passo atual: circulo cheio na cor primaria.</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>Classe CSS extra no elemento raiz.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Atributos repassados ao elemento raiz.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassesDaRaiz => ClassesCss.Juntar(Active ? "rvm-indicador rvm-ativo" : "rvm-indicador", Class, AdditionalAttributes);
}
