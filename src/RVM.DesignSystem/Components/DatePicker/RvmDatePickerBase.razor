@namespace RVM.DesignSystem.Components.DatePicker
@using RVM.DesignSystem.Components.Calendar
@using RVM.DesignSystem.Components.Icon
@using RVM.DesignSystem.Icons

@* O campo e um botao que abre um DIALOGO com o calendario (padrao "Date Picker Dialog" do APG):
   aria-haspopup="dialog", foco vai para o dia ao abrir, Esc fecha e devolve o foco ao botao. O valor
   aparece no proprio botao e entra no nome acessivel junto com o rotulo. Fechado, o calendario nao
   existe no DOM: o estado inicial sai pronto sem JS. *@
<div class="@ClassesDaRaiz" style="@EstiloDoConsumidor">
    <div class="rvm-caixa">
        <button @ref="_gatilho"
                @attributes="AtributosDoGatilho"
                type="button"
                id="@IdGatilho"
                class="rvm-entrada"
                aria-haspopup="dialog"
                aria-expanded="@(_aberto ? "true" : "false")"
                aria-labelledby="@($"{IdRotulo} {IdValor}")"
                aria-invalid="@(TemErro ? "true" : null)"
                aria-describedby="@(MensagemDeApoio is null ? null : IdApoio)"
                disabled="@Disabled"
                @onclick="AbrirOuFechar">
            <span id="@IdValor" class="rvm-valor">@(TemValor ? TextoExibido : PlaceholderEfetivo)</span>
        </button>

        <span id="@IdRotulo" class="rvm-rotulo">
            @Label
            @if (Required)
            {
                <span class="rvm-obrigatorio" aria-hidden="true">*</span>
                <span class="rvm-so-leitor">(obrigatorio)</span>
            }
        </span>

        <span class="rvm-icone-campo" aria-hidden="true">
            <RvmIcon Name="RvmIconName.Calendar" Size="RvmSize.Small" />
        </span>
    </div>

    @if (MensagemDeApoio is not null)
    {
        <div id="@IdApoio" class="rvm-apoio rvm-text-helper">@MensagemDeApoio</div>
    }

    @if (!string.IsNullOrWhiteSpace(Name))
    {
        @foreach (var (sufixo, valor) in ValoresParaEnvio)
        {
            <input type="hidden" name="@($"{Name}{sufixo}")" value="@valor" />
        }
    }

    @if (_aberto)
    {
        <div class="rvm-fundo" @onclick="() => FecharAsync()"></div>
        <div @ref="_popup" class="rvm-popup" role="dialog" aria-modal="true" aria-label="@DialogLabel" tabindex="-1"
             @onkeydown="AoTeclarNoDialogoAsync" @onkeydown:stopPropagation="true">
            @Calendario
        </div>
    }
</div>
