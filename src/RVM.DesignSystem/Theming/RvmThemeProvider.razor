@namespace RVM.DesignSystem.Theming

@* Raiz da tematizacao. O `data-theme` fica NESTE elemento, e nao so no <html>, de proposito: assim
   o tema correto sai ja na primeira renderizacao, sem JS — a regra dos dois modos de hospedagem
   (Server e WebAssembly). O JS entra so para persistir a escolha e pintar o <html>.
   Os outros atributos (DSGN-017) seguem a mesma regra: paleta, esquema de cor, tamanho da fonte, contraste
   alto e menos movimento sao todos CSS lido do proprio elemento (rvm-design-system.css). *@
<div @attributes="AdditionalAttributes" class="@CssClass" data-theme="@ThemeAttribute"
     data-rvm-accent="@AccentAttribute"
     data-rvm-contrast="@(ColorScheme == RvmColorScheme.Original ? "original" : "accessible")"
     data-rvm-font-scale="@(_tema?.FontScaleAttribute)"
     data-rvm-high-contrast="@(_tema?.HighContrast == true ? "true" : null)"
     data-rvm-motion="@(_tema?.ReducedMotion == true ? "reduce" : null)">
    <CascadingValue TValue="RvmThemeProvider" Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>
