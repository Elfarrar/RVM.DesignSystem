<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- ADR-004: a versao publicada vem do workflow (-p:Version=...), nunca daqui. Este valor so
         existe para o pack local nao virar um "1.0.0" plausivel por acidente. -->
    <Version>0.0.0-local</Version>

    <PackageId>RVM.DesignSystem</PackageId>
    <Authors>Rafael Veneroso Morici</Authors>
    <Company>RVM</Company>
    <Description>Biblioteca de componentes Blazor (Server e WebAssembly) do ecossistema RVM. O visual deriva do kit NEATLAB - Super Admin Dashboard UI Design Kit, de hello.uiworld (Figma Community), sob CC BY 4.0.</Description>
    <PackageTags>blazor;components;design-system;razor-class-library</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Elfarrar/RVM.DesignSystem</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Elfarrar/RVM.DesignSystem</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
