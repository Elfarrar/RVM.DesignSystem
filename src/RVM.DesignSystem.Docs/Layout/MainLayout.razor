@inherits LayoutComponentBase
@inject IJSRuntime JS

@* O site usa a propria moldura da biblioteca: menu lateral com as secoes e os componentes das quatro
   ondas, barra do topo com o seletor de tema e o credito no rodape. Estreito, o menu vira gaveta. *@
<RvmThemeProvider @bind-Theme="_tema" class="pagina">
    <RvmAppShell @bind-Collapsed="_recolhido" NavigationLabel="Menu do site">
        <Brand>
            <a class="site-marca" href="">
                <img src="favicon.png" alt="" width="28" height="28" />
                <span>RVM Design System</span>
            </a>
        </Brand>

        <Navigation>
            <RvmNavItem Href="" Text="Inicio" Icon="RvmIconName.Home" Match="RvmNavMatch.All" />
            <RvmNavItem Href="fundamentos" Text="Fundamentos" Icon="RvmIconName.Pencil" />
            <RvmNavItem Href="componentes" Text="Componentes" Icon="RvmIconName.Copy" Match="RvmNavMatch.All" />
            @foreach (var grupo in Catalogo.Grupos)
            {
                <RvmNavSection @key="grupo.Titulo" Title="@grupo.Titulo">
                    @foreach (var componente in grupo.Componentes)
                    {
                        <RvmNavItem @key="componente.Rota" Href="@componente.Rota" Text="@componente.NomeCurto" />
                    }
                </RvmNavSection>
            }
        </Navigation>

        <TopBar>
            <span class="site-espaco"></span>
            @* aria-pressed vai como "true"/"false" em TEXTO: com bool, o Blazor omite o atributo quando e
               false e emite vazio quando e true — o leitor de tela fica sem o estado. *@
            <button type="button" class="seletor-tema rvm-text-button-sm" @onclick="TrocarTema"
                    aria-pressed="@(_tema == RvmTheme.Dark ? "true" : "false")">
                @(_tema == RvmTheme.Dark ? "Tema escuro" : "Tema claro")
            </button>
        </TopBar>

        <ChildContent>
            <div class="site-conteudo">
                @Body
            </div>
        </ChildContent>

        <Footer>
            @* Credito CC BY 4.0 ao kit de origem: obrigacao de licenca, presente em TODA pagina. *@
            <span class="rvm-text-caption">
                Visual derivado do
                <a href="https://www.figma.com/community/file/1353029852156886079/neatlab-super-admin-dashboard-ui-design-kit"
                   target="_blank" rel="noopener">NEATLAB — Super Admin Dashboard UI Design Kit</a>,
                de <strong>hello.uiworld</strong>, sob
                <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>.
                Codigo sob licenca MIT.
            </span>
        </Footer>
    </RvmAppShell>

    @* Onde as mensagens do RvmSnackbarService aparecem: um so, dentro do provedor de tema. *@
    <RvmSnackbarHost />
</RvmThemeProvider>

@code {
    private RvmTheme _tema = RvmTheme.Light;
    private bool _recolhido;

    protected override void OnInitialized()
    {
        // WebAssembly tem interop sincrono, entao da para comecar ja com o tema guardado e nao
        // piscar claro antes de trocar. O <script> inline do index.html faz o mesmo no <html>.
        if (JS is IJSInProcessRuntime sincrono && sincrono.Invoke<string?>("rvmTheme.read") == "dark")
        {
            _tema = RvmTheme.Dark;
        }
    }

    private void TrocarTema()
        => _tema = _tema == RvmTheme.Dark ? RvmTheme.Light : RvmTheme.Dark;
}
