@inherits LayoutComponentBase
@inject IJSRuntime JS

<RvmThemeProvider @bind-Theme="_tema" class="pagina">
    <header class="topo">
        <a class="marca rvm-text-h6" href="">RVM Design System</a>

        <nav class="menu" aria-label="Secoes do site">
            <NavLink class="link" href="" Match="NavLinkMatch.All">Inicio</NavLink>
            <NavLink class="link" href="fundamentos">Fundamentos</NavLink>
            <NavLink class="link" href="componentes">Componentes</NavLink>
        </nav>

        @* Seletor de tema no topo, visivel em toda pagina: e o jeito de conferir claro/escuro sem F5.
           O aria-pressed vai como "true"/"false" em TEXTO: com bool, o Blazor omite o atributo
           quando e false e emite vazio quando e true — o leitor de tela fica sem o estado.
           ⚠️ Comentario Razor NAO pode ficar entre os atributos: compila e vira um setAttribute
           invalido em tempo de execucao, derrubando a pagina inteira. *@
        <button type="button" class="seletor-tema rvm-text-button-sm" @onclick="TrocarTema"
                aria-pressed="@(_tema == RvmTheme.Dark ? "true" : "false")">
            @(_tema == RvmTheme.Dark ? "Tema escuro" : "Tema claro")
        </button>
    </header>

    <main class="conteudo">
        @Body
    </main>

    @* Credito CC BY 4.0 ao kit de origem: obrigacao de licenca, presente em TODA pagina. *@
    <footer class="rodape rvm-text-caption">
        Visual derivado do
        <a href="https://www.figma.com/community/file/1353029852156886079/neatlab-super-admin-dashboard-ui-design-kit"
           target="_blank" rel="noopener">NEATLAB — Super Admin Dashboard UI Design Kit</a>,
        de <strong>hello.uiworld</strong>, sob
        <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>.
        Codigo sob licenca MIT.
    </footer>
</RvmThemeProvider>

@code {
    private RvmTheme _tema = RvmTheme.Light;

    protected override void OnInitialized()
    {
        // WebAssembly tem interop sincrono, entao da para comecar ja com o tema guardado e nao
        // piscar claro antes de trocar. O <script> inline do index.html faz o mesmo no <html>.
        if (JS is IJSInProcessRuntime sincrono && sincrono.Invoke<string?>("rvmTheme.read") == "dark")
        {
            _tema = RvmTheme.Dark;
        }
    }

    private void TrocarTema()
        => _tema = _tema == RvmTheme.Dark ? RvmTheme.Light : RvmTheme.Dark;
}
