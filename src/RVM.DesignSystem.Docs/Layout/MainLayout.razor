@inherits LayoutComponentBase
@inject IRvmThemeService Tema
@inject PaletaDoVisitante Paleta
@inject IJSRuntime JS
@implements IDisposable

@*
    ⚠️ Este arquivo É o critério de saída da onda 2 (`09-roadmap.md`).

    Até a onda 1, a casca do site era HTML escrito à mão aqui dentro: um `header`, um `nav` com
    `NavLink`, um `main` com `tabindex="-1"` e um link de pulo — as mesmas ~60 linhas que os
    quatro `MainLayout` do ecossistema duplicam, cada um com um detalhe de acessibilidade a
    menos que o vizinho.

    Agora é `RvmAppShell` + `RvmSidebar` + `RvmTopbar`. O que sobrou aqui é só o que é DESTE
    site: o seletor de temas, os dados do menu e o texto do rodapé. A casca deixou de ser código
    de exemplo e virou código em produção — que é exatamente o que a onda tinha para provar.
*@

<RvmThemeProvider>
    <RvmAppShell>
        <Topbar>
            <RvmTopbar>
                <Start>
                    <a class="site-brand" href="">RVM Design System</a>
                </Start>
                <Center>
                    <CampoDeBusca />
                </Center>
                <End>
                    <label class="site-controls__label" for="seletor-tema">Tema</label>
                    @*
                        O valor da opcao e o INDICE, nao o nome. A paleta montada em
                        /fundamentos/paleta entra nesta lista, e nada impede alguem de batiza-la
                        "RVM" — por nome, escolher a dela devolveria a embutida, descartando o
                        trabalho em silencio.
                    *@
                    <select id="seletor-tema" class="site-controls__select" @onchange="TrocarTema">
                        @for (var i = 0; i < TemasDoSeletor.Count; i++)
                        {
                            var t = TemasDoSeletor[i];
                            <option value="@i" selected="@(t == _temaBase)">
                                @(i >= RvmThemes.All.Count ? $"{t.Name} (sua paleta)" : t.Name)
                            </option>
                        }
                    </select>

                    @*
                        PREVIEW temporario (DSGN-025): as duas direcoes de aparencia no ar ao
                        mesmo tempo, para uma decisao de gosto ser tomada olhando, e nao lendo
                        a minha descricao delas. Este bloco sai quando a direcao for escolhida.
                    *@
                    <label class="site-controls__label" for="seletor-aparencia">Aparência</label>
                    <select id="seletor-aparencia" class="site-controls__select" @onchange="TrocarAparencia">
                        <option value="atual" selected="@(_aparencia == "atual")">Atual (v1)</option>
                        <option value="sobrio" selected="@(_aparencia == "sobrio")">Sóbrio</option>
                        <option value="marcante" selected="@(_aparencia == "marcante")">Marcante</option>
                        <option value="vivo" selected="@(_aparencia == "vivo")">Vivo</option>
                    </select>

                    <RvmIconButton Icon="@(_escuro ? "eye" : "eye-slash")"
                                   Label="@(_escuro ? "Mudar para o tema claro" : "Mudar para o tema escuro")"
                                   OnClick="AlternarModo" />
                </End>
            </RvmTopbar>
        </Topbar>

        <Sidebar>
            <RvmSidebar Label="Navegação da documentação">
                @foreach (var grupo in Navegacao.Grupos)
                {
                    <RvmNavGroup Title="@grupo.Titulo">
                        @foreach (var item in grupo.Itens)
                        {
                            @*
                                Exact no item da raiz. Sem ele, "Início" (href="") ficaria aceso
                                em todas as páginas do site, porque "" é prefixo de toda rota.
                            *@
                            <RvmNavItem Text="@item.Texto"
                                        Href="@item.Rota"
                                        Icon="@item.Icone"
                                        Exact="@(item.Rota.Length == 0)" />
                        }
                    </RvmNavGroup>
                }
            </RvmSidebar>
        </Sidebar>

        <Footer>
            <p class="site-rodape__texto">
                Biblioteca de componentes Blazor do ecossistema RVM · MIT
            </p>
        </Footer>

        <ChildContent>
            <div class="site-conteudo">
                @Body
            </div>
        </ChildContent>
    </RvmAppShell>

    @*
        Os dois hosts vão UMA vez, aqui, e não em cada página.

        No RvmToastHost isso é requisito, não organização: as regiões `aria-live` dele precisam
        existir no DOM ANTES da primeira mensagem, senão o leitor de tela não tem o que observar
        e a notificação passa em silêncio. Montá-los por tela recriaria as regiões a cada
        navegação, e a mensagem disparada logo depois de navegar seria justamente a perdida.
    *@
    <RvmToastHost />
    <RvmDialogHost />
</RvmThemeProvider>

@code {
    private bool _escuro;

    /// <summary>Aparencia escolhida no preview temporario (DSGN-025).</summary>
    private string _aparencia = "atual";

    /// <summary>O tema escolhido no seletor, SEM tingir.</summary>
    /// <remarks>
    /// Precisa existir separado porque o "vivo" troca o tema aplicado por um derivado dele. Sem
    /// guardar a base, o seletor nao acharia o tema tingido na lista e passaria a chama-lo de
    /// "sua paleta" — mentindo sobre o que o visitante escolheu.
    /// </remarks>
    private RvmTheme _temaBase = RvmThemes.Rvm;

    private async Task TrocarAparencia(ChangeEventArgs e)
    {
        _aparencia = e.Value?.ToString() ?? "atual";
        await JS.InvokeVoidAsync("rvmAparencia.definir", _aparencia);
        await Tema.SetThemeAsync(_aparencia == "vivo" ? AparenciaViva.Tingir(_temaBase) : _temaBase);
    }

    /// <summary>
    /// Mantem o tingimento colado no tema, venha a troca de onde vier.
    /// </summary>
    /// <remarks>
    /// O tema muda por tres caminhos: este seletor, o de aparencia e a pagina
    /// <c>/fundamentos/paleta</c>. Reagir ao evento cobre os tres de uma vez, em vez de eu ter
    /// de lembrar de tingir em cada um.
    ///
    /// <para>
    /// <b>Nao ha laco porque <c>Tingir</c> e idempotente</b>: as superficies saem de valores
    /// fixos calculados da matiz da primaria, que o tingimento nao altera. Tingir duas vezes da
    /// o mesmo tema, a comparacao por valor da igual, e a segunda passada nao faz nada.
    /// </para>
    /// </remarks>
    private void AoMudarTema()
    {
        var atual = Tema.Theme;
        var tingido = AparenciaViva.Tingir(atual);

        if (atual == tingido)
        {
            return;   // ja esta tingido — nada a fazer, e e aqui que o laco para
        }

        _temaBase = atual;

        if (_aparencia == "vivo")
        {
            InvokeAsync(() => Tema.SetThemeAsync(tingido));
        }
    }

    protected override void OnInitialized() => Tema.Changed += AoMudarTema;

    public void Dispose() => Tema.Changed -= AoMudarTema;

    /// <summary>
    /// Os temas que o seletor oferece: os embutidos e, quando ha uma, a paleta do visitante.
    /// </summary>
    /// <remarks>
    /// Sem a segunda parte o seletor MENTIRIA: com um tema fora da lista aplicado, nenhuma opcao
    /// casa e o navegador mostra a primeira — o menu diria "RVM" com o site em outras cores. E o
    /// mesmo defeito que o RvmSelect teve na onda 1, e pela mesma causa.
    ///
    /// <para>
    /// A comparacao e por VALOR: <see cref="RvmTheme"/> e record. Uma paleta identica a uma
    /// embutida nao aparece duas vezes, porque nao e outro tema.
    /// </para>
    /// </remarks>
    private IReadOnlyList<RvmTheme> TemasDoSeletor =>
        RvmThemes.All.Contains(_temaBase) ? RvmThemes.All : [.. RvmThemes.All, _temaBase];

    private async Task TrocarTema(ChangeEventArgs e)
    {
        var lista = TemasDoSeletor;

        if (!int.TryParse(e.Value?.ToString(), out var i) || i < 0 || i >= lista.Count)
        {
            return;
        }

        _temaBase = lista[i];
        await Tema.SetThemeAsync(_aparencia == "vivo" ? AparenciaViva.Tingir(_temaBase) : _temaBase);

        // Escolher um tema embutido APAGA a paleta guardada. Sem isto o proximo F5 a traria de
        // volta por cima da escolha que acabou de ser feita aqui.
        if (i < RvmThemes.All.Count)
        {
            await Paleta.EsquecerAsync();
        }
    }

    private async Task AlternarModo()
    {
        _escuro = !_escuro;
        await Tema.SetPreferenceAsync(_escuro ? RvmThemePreference.Dark : RvmThemePreference.Light);
    }

    protected override async Task OnAfterRenderAsync(bool primeiraVez)
    {
        if (!primeiraVez)
        {
            return;
        }

        if (Tema is RvmThemeService servico)
        {
            var preferencia = await servico.LoadPreferenceAsync();
            _escuro = preferencia == RvmThemePreference.Dark;
        }

        // A paleta do visitante e lida pela CASCA, e nao so pela pagina que a monta: ela vale
        // para o site inteiro, entao entrar direto em /componentes/button ja tem que chegar
        // pintado. A leitura do localStorage acontece uma vez so — o servico e quem garante.
        await Paleta.CarregarAsync();

        // O atributo ja foi aplicado pelo script, antes do primeiro paint; aqui o C# so descobre
        // qual e, para o seletor nao mostrar "Atual" com a pagina em outra aparencia.
        _aparencia = await JS.InvokeAsync<string>("rvmAparencia.atual");

        if (_aparencia == "vivo")
        {
            await Tema.SetThemeAsync(AparenciaViva.Tingir(Tema.Theme));
        }

        StateHasChanged();
    }
}
