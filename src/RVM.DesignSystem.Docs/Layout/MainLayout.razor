@inherits LayoutComponentBase
@inject IRvmThemeService Tema

@*
    ⚠️ Este arquivo É o critério de saída da onda 2 (`09-roadmap.md`).

    Até a onda 1, a casca do site era HTML escrito à mão aqui dentro: um `header`, um `nav` com
    `NavLink`, um `main` com `tabindex="-1"` e um link de pulo — as mesmas ~60 linhas que os
    quatro `MainLayout` do ecossistema duplicam, cada um com um detalhe de acessibilidade a
    menos que o vizinho.

    Agora é `RvmAppShell` + `RvmSidebar` + `RvmTopbar`. O que sobrou aqui é só o que é DESTE
    site: o seletor de temas, os dados do menu e o texto do rodapé. A casca deixou de ser código
    de exemplo e virou código em produção — que é exatamente o que a onda tinha para provar.
*@

<RvmThemeProvider>
    <RvmAppShell>
        <Topbar>
            <RvmTopbar>
                <Start>
                    <a class="site-brand" href="">RVM Design System</a>
                </Start>
                <Center>
                    <CampoDeBusca />
                </Center>
                <End>
                    <label class="site-controls__label" for="seletor-tema">Tema</label>
                    @*
                        O valor da opcao e o INDICE, nao o nome. A paleta montada em
                        /fundamentos/paleta entra nesta lista, e nada impede alguem de batiza-la
                        "RVM" — por nome, escolher a dela devolveria a embutida, descartando o
                        trabalho em silencio.
                    *@
                    <select id="seletor-tema" class="site-controls__select" @onchange="TrocarTema">
                        @for (var i = 0; i < TemasDoSeletor.Count; i++)
                        {
                            var t = TemasDoSeletor[i];
                            <option value="@i" selected="@(t == Tema.Theme)">
                                @(i >= RvmThemes.All.Count ? $"{t.Name} (sua paleta)" : t.Name)
                            </option>
                        }
                    </select>

                    <RvmIconButton Icon="@(_escuro ? "eye" : "eye-slash")"
                                   Label="@(_escuro ? "Mudar para o tema claro" : "Mudar para o tema escuro")"
                                   OnClick="AlternarModo" />
                </End>
            </RvmTopbar>
        </Topbar>

        <Sidebar>
            <RvmSidebar Label="Navegação da documentação">
                @foreach (var grupo in Navegacao.Grupos)
                {
                    <RvmNavGroup Title="@grupo.Titulo">
                        @foreach (var item in grupo.Itens)
                        {
                            @*
                                Exact no item da raiz. Sem ele, "Início" (href="") ficaria aceso
                                em todas as páginas do site, porque "" é prefixo de toda rota.
                            *@
                            <RvmNavItem Text="@item.Texto"
                                        Href="@item.Rota"
                                        Icon="@item.Icone"
                                        Exact="@(item.Rota.Length == 0)" />
                        }
                    </RvmNavGroup>
                }
            </RvmSidebar>
        </Sidebar>

        <Footer>
            <p class="site-rodape__texto">
                Biblioteca de componentes Blazor do ecossistema RVM · MIT
            </p>
        </Footer>

        <ChildContent>
            <div class="site-conteudo">
                @Body
            </div>
        </ChildContent>
    </RvmAppShell>

    @*
        Os dois hosts vão UMA vez, aqui, e não em cada página.

        No RvmToastHost isso é requisito, não organização: as regiões `aria-live` dele precisam
        existir no DOM ANTES da primeira mensagem, senão o leitor de tela não tem o que observar
        e a notificação passa em silêncio. Montá-los por tela recriaria as regiões a cada
        navegação, e a mensagem disparada logo depois de navegar seria justamente a perdida.
    *@
    <RvmToastHost />
    <RvmDialogHost />
</RvmThemeProvider>

@code {
    private bool _escuro;

    /// <summary>
    /// Os temas que o seletor oferece: os embutidos e, quando ha uma, a paleta do visitante.
    /// </summary>
    /// <remarks>
    /// Sem a segunda parte o seletor MENTIRIA: com um tema fora da lista aplicado, nenhuma opcao
    /// casa e o navegador mostra a primeira — o menu diria "RVM" com o site em outras cores. E o
    /// mesmo defeito que o RvmSelect teve na onda 1, e pela mesma causa.
    ///
    /// <para>
    /// A comparacao e por VALOR: <see cref="RvmTheme"/> e record. Uma paleta identica a uma
    /// embutida nao aparece duas vezes, porque nao e outro tema.
    /// </para>
    /// </remarks>
    private IReadOnlyList<RvmTheme> TemasDoSeletor =>
        RvmThemes.All.Contains(Tema.Theme) ? RvmThemes.All : [.. RvmThemes.All, Tema.Theme];

    private async Task TrocarTema(ChangeEventArgs e)
    {
        var lista = TemasDoSeletor;

        if (int.TryParse(e.Value?.ToString(), out var i) && i >= 0 && i < lista.Count)
        {
            await Tema.SetThemeAsync(lista[i]);
        }
    }

    private async Task AlternarModo()
    {
        _escuro = !_escuro;
        await Tema.SetPreferenceAsync(_escuro ? RvmThemePreference.Dark : RvmThemePreference.Light);
    }

    protected override async Task OnAfterRenderAsync(bool primeiraVez)
    {
        if (primeiraVez && Tema is RvmThemeService servico)
        {
            var preferencia = await servico.LoadPreferenceAsync();
            _escuro = preferencia == RvmThemePreference.Dark;
            StateHasChanged();
        }
    }
}
