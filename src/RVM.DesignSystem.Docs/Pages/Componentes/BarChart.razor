    private const string CodigoVertical = """
        <RvmBarChart Items="custos" Label="c => c.Cultura" AriaLabel="Custo por hectare"
                     Layout="RvmBarLayout.Vertical">
            <RvmChartSeries Name="Fertilizantes" Value="c => c.Fertilizantes" />
            <RvmChartSeries Name="Defensivos" Value="c => c.Defensivos" Color="RvmColor.Success" />
        </RvmBarChart>
        """;

    private const string CodigoDivergente = """
