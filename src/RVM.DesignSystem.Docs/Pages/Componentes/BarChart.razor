                     SecondaryValueFormat="@(v => v + " sc/ha")">
            <RvmChartSeries Name="Area" Value="t => t.Area" />
            <RvmChartSeries Name="Produtividade" Value="t => t.Produtividade" Axis="RvmChartAxis.Secondary" />
        </RvmBarChart>
        """;

    private const string CodigoSimples = """
        <RvmBarChart Items="talhoes" Label="t => t.Nome" AriaLabel="Produtividade por talhao"
