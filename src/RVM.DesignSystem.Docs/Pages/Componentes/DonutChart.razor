    private const string CodigoEstados = """
        <RvmDonutChart Label="Area plantada" Slices="culturas" Loading="carregando" />
        <RvmDonutChart Label="Area plantada" Slices="culturas" Error="falhou" ErrorMascot="RvmMascotName.RobotError" />
