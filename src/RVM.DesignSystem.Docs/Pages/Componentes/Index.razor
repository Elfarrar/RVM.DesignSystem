        ("componentes/chip", "RvmChip", "Filled e outlined, com avatar, removivel.", true),
        ("componentes/alert", "RvmAlert", "Seis papeis, contained e outlined, fechavel.", true),
        ("componentes/card", "RvmCard", "Basico, com cabecalho, com acoes, com midia.", true),
