@page "/componentes/line-chart"

<PageTitle>RvmLineChart — RVM Design System</PageTitle>

<h1 class="rvm-text-h4">RvmLineChart</h1>

<p class="rvm-text-body1 site-apoio">
    Pontos ligados por linhas para mostrar como os valores mudam ao longo do tempo. Reta ou suave: a curva suave
    e monotona — passa por todos os pontos sem inventar picos entre eles. Os pontos aparecem na categoria ativa
    (mouse ou teclado) ou em todas, com <code>ShowPoints</code>.
</p>

<BlocoExemplo Titulo="Suave, uma serie"
              Descricao="O Total Sales do kit: vendas mes a mes."
              Codigo="@CodigoSuave">
    <RvmLineChart Items="Vendas" Label="v => v.Mes" AriaLabel="Vendas por mes" Smooth="true" Height="260"
                  ValueFormat="@(v => $"R$ {RvmChartFormat.Compact(v)}")">
        <RvmChartSeries Name="Vendas" Value="v => v.Valor" Color="RvmColor.Success" />
    </RvmLineChart>
</BlocoExemplo>

<BlocoExemplo Titulo="Varias series com pontos, aproximavel"
              Descricao="Chuva mensal em tres fazendas, em mm. Com Zoomable, a roda do mouse aproxima o eixo dos meses (Shift para o dos milimetros), o arrasto desloca e o duplo clique volta; pelo teclado, + - 0 e Ctrl com as setas."
              Codigo="@CodigoSeries">
    <RvmLineChart Items="Chuvas" Label="c => c.Mes" AriaLabel="Chuva mensal por fazenda" ShowPoints="true" Zoomable="true"
                  ValueFormat="@(v => $"{RvmChartFormat.Number(v)} mm")">
        <RvmChartSeries Name="Boa Vista" Value="c => c.BoaVista" />
        <RvmChartSeries Name="Santa Luzia" Value="c => c.SantaLuzia" Color="RvmColor.Warning" />
        <RvmChartSeries Name="Terra Nova" Value="c => c.TerraNova" Color="RvmColor.Info" />
    </RvmLineChart>
</BlocoExemplo>

<BlocoExemplo Titulo="Eixo duplo"
              Descricao="Receita em reais a esquerda e margem em porcento a direita: cada serie na escala do seu eixo, e a legenda diz qual."
              Codigo="@CodigoEixoDuplo">
    <RvmLineChart Items="Resultados" Label="r => r.Mes" AriaLabel="Receita e margem por mes" ShowPoints="true"
                  SecondaryValueFormat="@(v => RvmChartFormat.Number(v) + "%")">
        <RvmChartSeries Name="Receita" Value="r => r.Receita" />
        <RvmChartSeries Name="Margem" Value="r => r.Margem" Color="RvmColor.Warning" Axis="RvmChartAxis.Secondary" />
    </RvmLineChart>
</BlocoExemplo>

<TabelaParametros Componente="RvmLineChart" />

<RecorteDoKit Origem="kit/line-chart.png"
              Arquivo="referencia-neatlab/Chart Card.png (recorte)"
              Descricao="O cartao Total Sales: linha suave e rotulos dos meses."
              Alt="Recorte do kit NEATLAB com um grafico de linha suave" />

@code {
    private static readonly (string Mes, double Valor)[] Vendas =
        [("Jan", 12_400), ("Fev", 31_800), ("Mar", 14_200), ("Abr", 28_900), ("Mai", 17_500), ("Jun", 38_200)];

    private static readonly (string Mes, double BoaVista, double SantaLuzia, double TerraNova)[] Chuvas =
    [
        ("Set", 45, 30, 62), ("Out", 128, 110, 140), ("Nov", 196, 172, 210), ("Dez", 240, 260, 228),
        ("Jan", 262, 238, 250), ("Fev", 210, 198, 186), ("Mar", 170, 150, 190)
    ];

    private static readonly (string Mes, double Receita, double Margem)[] Resultados =
    [
        ("Jan", 128_000, 11.5), ("Fev", 164_000, 14.2), ("Mar", 142_000, 9.8),
        ("Abr", 186_000, 16.4), ("Mai", 172_000, 15.1), ("Jun", 204_000, 18.7)
    ];

    private const string CodigoSuave = """
        <RvmLineChart Items="vendas" Label="v => v.Mes" AriaLabel="Vendas por mes" Smooth="true">
            <RvmChartSeries Name="Vendas" Value="v => v.Valor" Color="RvmColor.Success" />
        </RvmLineChart>
        """;

    private const string CodigoEixoDuplo = """
        <RvmLineChart Items="resultados" Label="r => r.Mes" AriaLabel="Receita e margem por mes"
                      SecondaryValueFormat="@(v => v + "%")">
            <RvmChartSeries Name="Receita" Value="r => r.Receita" />
            <RvmChartSeries Name="Margem" Value="r => r.Margem" Axis="RvmChartAxis.Secondary" />
        </RvmLineChart>
        """;

    private const string CodigoSeries = """
        <RvmLineChart Items="chuvas" Label="c => c.Mes" AriaLabel="Chuva mensal por fazenda" ShowPoints="true" Zoomable="true">
            <RvmChartSeries Name="Boa Vista" Value="c => c.BoaVista" />
            <RvmChartSeries Name="Santa Luzia" Value="c => c.SantaLuzia" Color="RvmColor.Warning" />
        </RvmLineChart>
        """;
}
