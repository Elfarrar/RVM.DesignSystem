@page "/componentes/widget"
@using RVM.DesignSystem.Components.Activity
@using RVM.DesignSystem.Components.Widget

<PageTitle>RvmWidget — RVM Design System</PageTitle>

<h1 class="rvm-text-h4">RvmWidget</h1>

<p class="rvm-text-body1 site-apoio">
    Os widgets do topo dos dashboards do kit: um gatilho (icone com contador, ou cartao com imagem e nome) que abre
    um painel. O painel e um dialogo nao modal: abrir leva o foco para ele, Esc e o X fecham e devolvem o foco ao
    gatilho, clicar fora fecha. Fechado, o painel nao existe na pagina. Aceita <code>@@bind-Open</code>.
</p>

<p class="rvm-text-body2 site-apoio">
    Do contrato de API com o RVM.UI (DSGN-017): a mesma API, com o visual do NEATLAB.
</p>

<BlocoExemplo Titulo="Notificacoes, idioma e perfil"
              Descricao="O sino abre a folha com os avisos (RvmNotificationItem); a bandeira e o perfil abrem listas."
              Codigo="@Codigo">
    <div class="linha-exemplos exemplo-widgets">
        <RvmWidget Label="Notificacoes" Icon="RvmIconName.Bell" Badge="@NaoLidos" Size="RvmWidgetPanelSize.Sheet"
                   PanelTitle="Notificacoes" @bind-Open="_avisosAbertos">
            <ChildContent>
                <ul class="exemplo-lista-avisos">
                    @foreach (var aviso in _avisos)
                    {
                        <RvmNotificationItem Title="@aviso.Titulo" Text="@aviso.Texto" Read="aviso.Lido"
                                             OnRead="@(() => aviso.Lido = true)" />
                    }
                </ul>
            </ChildContent>
            <Footer>
                <RvmButton Variant="RvmButtonVariant.Text" Size="RvmSize.Small" OnClick="MarcarTodas">Marcar todas como lidas</RvmButton>
            </Footer>
        </RvmWidget>

        <RvmWidget Label="Idioma" ImageUrl="@Bandeira">
            <RvmButton Variant="RvmButtonVariant.Text" Class="exemplo-opcao">Portugues</RvmButton>
            <RvmButton Variant="RvmButtonVariant.Text" Class="exemplo-opcao">Espanhol</RvmButton>
        </RvmWidget>

        <div class="exemplo-cartao">
            <RvmWidget Label="Perfil" Variant="RvmWidgetVariant.Card" Title="Ana Souza" Subtitle="Agronoma"
                       ImageUrl="@Foto" Placement="RvmMenuPlacement.BottomStart">
                <RvmButton Variant="RvmButtonVariant.Text" StartIcon="RvmIconName.User" Class="exemplo-opcao">Meu perfil</RvmButton>
                <RvmButton Variant="RvmButtonVariant.Text" StartIcon="RvmIconName.Settings" Class="exemplo-opcao">Configuracoes</RvmButton>
                <RvmButton Variant="RvmButtonVariant.Text" StartIcon="RvmIconName.Logout" Class="exemplo-opcao">Sair</RvmButton>
            </RvmWidget>
        </div>

        <RvmWidget Label="Mensagens" Icon="RvmIconName.Mail" Disabled="true" />
    </div>
    <RvmTypography Color="RvmTextColor.Secondary" aria-live="polite">Painel de notificacoes: @(_avisosAbertos ? "aberto" : "fechado")</RvmTypography>
</BlocoExemplo>

<TabelaParametros Componente="RvmWidget" />

@code {
    private bool _avisosAbertos;

    private sealed class Aviso(string titulo, string texto)
    {
        public string Titulo { get; } = titulo;
        public string Texto { get; } = texto;
        public bool Lido { get; set; }
    }

    private readonly List<Aviso> _avisos =
    [
        new("Boleto do adubo vence amanha", "Fornecedor Agro Sul, R$ 48.200,00"),
        new("Colheita do talhao 12 concluida", "58 sacas por hectare"),
        new("Nova mensagem da cooperativa", "Proposta de preco para a soja")
    ];

    private int NaoLidos => _avisos.Count(a => !a.Lido);

    private void MarcarTodas() => _avisos.ForEach(a => a.Lido = true);

    private const string Bandeira =
        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 28 28'><rect width='28' height='28' fill='%23009C3B'/><path d='M14 5 25 14 14 23 3 14z' fill='%23FFDF00'/><circle cx='14' cy='14' r='5' fill='%23002776'/></svg>";

    private const string Foto =
        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' fill='%2316B1FF'/><circle cx='20' cy='16' r='7' fill='%23FFFFFF'/><rect x='9' y='26' width='22' height='14' rx='7' fill='%23FFFFFF'/></svg>";

    private const string Codigo = """
        <RvmWidget Label="Notificacoes" Icon="RvmIconName.Bell" Badge="naoLidos" Size="RvmWidgetPanelSize.Sheet"
                   PanelTitle="Notificacoes" @bind-Open="aberto">
            <ChildContent>
                <ul>
                    <RvmNotificationItem Title="Boleto do adubo vence amanha" OnRead="MarcarComoLida" />
                </ul>
            </ChildContent>
            <Footer>
                <RvmButton Variant="RvmButtonVariant.Text" OnClick="MarcarTodas">Marcar todas como lidas</RvmButton>
            </Footer>
        </RvmWidget>

        <RvmWidget Label="Perfil" Variant="RvmWidgetVariant.Card" Title="Ana Souza" Subtitle="Agronoma"
                   ImageUrl="ana.jpg" Placement="RvmMenuPlacement.BottomStart">
            ...
        </RvmWidget>
        """;
}
