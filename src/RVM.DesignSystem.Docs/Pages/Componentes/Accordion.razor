@page "/componentes/accordion"

<PageTitle>RvmAccordion — RVM Design System</PageTitle>

<h1 class="rvm-text-h4">RvmAccordion</h1>

<p class="rvm-text-body1 site-apoio">
    Paineis que abrem e fecham, no padrao "Accordion" do APG: cada titulo e um botao dentro de um
    cabecalho, e o conteudo e uma regiao ligada a ele. Com <code>Exclusive</code>, abrir um fecha os
    outros. Cabecalho de 52 px, <strong>medido no kit</strong>.
</p>

<BlocoExemplo Titulo="Padrao, com subtitulo"
              Descricao="A linha Simple do kit: o painel aberto se descola dos vizinhos."
              Codigo="@CodigoPadrao">
    <RvmAccordion>
        <RvmAccordionPanel Title="Plantio" SecondaryTitle="Soja, 120 ha">
            Semeadura entre 10 e 25 de outubro, 14 sementes por metro.
        </RvmAccordionPanel>
        <RvmAccordionPanel Title="Aplicacoes" SecondaryTitle="3 registradas" @bind-Expanded="_aplicacoesAbertas">
            Duas de fungicida e uma de inseticida, todas dentro da janela recomendada.
        </RvmAccordionPanel>
        <RvmAccordionPanel Title="Colheita" SecondaryTitle="Prevista para fevereiro" Disabled="true">
            Ainda sem dados.
        </RvmAccordionPanel>
    </RvmAccordion>
</BlocoExemplo>

<BlocoExemplo Titulo="Preenchido, exclusivo e com icone"
              Descricao="A linha Customized do kit: mais e menos no lugar da seta. So um painel aberto por vez."
              Codigo="@CodigoPreenchido">
    <RvmAccordion Variant="RvmAccordionVariant.Filled" Exclusive="true">
        <RvmAccordionPanel Title="Como cadastro um talhao?" Icon="RvmIconName.InfoCircle" Expanded="true">
            Em Talhoes, use Cadastrar talhao e desenhe o contorno no mapa.
        </RvmAccordionPanel>
        <RvmAccordionPanel Title="Posso importar notas fiscais?" Icon="RvmIconName.File">
            Sim: envie o XML em Financeiro, Notas, e confira os lancamentos antes de salvar.
        </RvmAccordionPanel>
        <RvmAccordionPanel Title="Quem ve os meus dados?" Icon="RvmIconName.Lock">
            So as pessoas que voce convidar para a fazenda.
        </RvmAccordionPanel>
    </RvmAccordion>
</BlocoExemplo>

<TabelaParametros Parametros="@Parametros" />

<RecorteDoKit Origem="kit/accordion.png"
              Arquivo="referencia-neatlab/Accordion.png (recorte)"
              Descricao="Simple e Customized, fechados e com o segundo painel aberto."
              Alt="Recorte do kit NEATLAB mostrando acordeoes fechados e abertos em dois estilos" />

@code {
    private bool _aplicacoesAbertas = true;

    private static readonly TabelaParametros.Parametro[] Parametros =
    [
        new("RvmAccordion.Exclusive", "bool", "false", "So um painel aberto por vez."),
        new("RvmAccordion.Variant", "RvmAccordionVariant", "Standard", "Standard ou Filled."),
        new("RvmAccordion.HeadingLevel", "int", "3", "Nivel dos cabecalhos, de 2 a 6."),
        new("Title", "string", "—", "Titulo do painel."),
        new("SecondaryTitle", "string?", "—", "Complemento ao lado do titulo."),
        new("Icon", "RvmIconName?", "—", "Icone antes do titulo."),
        new("Expanded", "bool", "false", "Aberto. Aceita @bind-Expanded."),
        new("Disabled", "bool", "false", "Nao abre nem fecha."),
        new("AdditionalAttributes", "IReadOnlyDictionary", "—", "Qualquer outro atributo, repassado a raiz.")
    ];

    private const string CodigoPadrao = """
        <RvmAccordion>
            <RvmAccordionPanel Title="Plantio" SecondaryTitle="Soja, 120 ha">...</RvmAccordionPanel>
            <RvmAccordionPanel Title="Aplicacoes" @bind-Expanded="_aberto">...</RvmAccordionPanel>
        </RvmAccordion>
        """;

    private const string CodigoPreenchido = """
        <RvmAccordion Variant="RvmAccordionVariant.Filled" Exclusive="true">
            <RvmAccordionPanel Title="Como cadastro um talhao?" Icon="RvmIconName.InfoCircle">...</RvmAccordionPanel>
        </RvmAccordion>
        """;
}
